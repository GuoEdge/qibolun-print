{"record_type": "article_reading", "schema_version": "0.2.0", "corpus_sha256": "E8617186FB3A82FD117C790499191B0E7B14D7A0C06E084C6D91CB5C5BF6AAA4", "article_id": "41824a1a-d9da-5134-a987-9f10639e2425", "source_ordinal": 3433, "reading_ordinal": 619, "source_version": "v2-current", "metadata": {"title": "同情的资格", "published_at": "2021-03-21T11:52:35+08:00", "platform": "zhihu", "url": "https://www.zhihu.com/question/441105696/answer/1791575775"}, "structure": {"full_text_checked": true, "paragraphs": [{"paragraph_id": "P001", "field": "body", "index": 1, "text": "你没有资格。", "char_start": 0, "char_end": 6}, {"paragraph_id": "P002", "field": "body", "index": 2, "text": "但你有义务。", "char_start": 7, "char_end": 13}, {"paragraph_id": "P003", "field": "body", "index": 3, "text": "这才是上帝黑色幽默的地方。", "char_start": 14, "char_end": 27}], "images": [], "lexical": {"node_counts": {"paragraph": 3}, "divergence": false, "divergence_count": 0}}, "reading": {"status": "read", "reader_id": "deepseek-v4.1-flash", "started_at": "2026-09-20T00:00:00+08:00", "completed_at": "2026-09-20T00:00:00+08:00", "image_checked": false, "batch_id": "r001-b0104"}, "analysis": {"question_context": "提问者问是否有资格同情无知而不自知的人。作者直接否定资格，同时提出同情属于义务，并以宗教化反讽收束。", "content_units": [{"unit_id": "U001", "paragraph_refs": ["P001"], "summary": "直接回答：没有资格。", "role": "answer"}, {"unit_id": "U002", "paragraph_refs": ["P002", "P003"], "summary": "把同情从个人资格改写为对他人的义务，并称其为上帝式黑色幽默。", "role": "reframing"}], "main_claims": [{"claim_id": "C001", "claim_type": "author_explicit", "attribution": "author", "modality": "asserted", "statement": "人没有以优越位置同情无知者的资格，但对他人仍负有同情义务。", "evidence_refs": ["E001", "E002"]}], "argument_steps": ["先否定资格（P001）。", "再提出义务和反讽解释（P002-P003）。"], "concept_usage": [{"term": "资格/义务", "meaning": "资格是可据以居高临下评价他人的正当性，义务是即使没有优越性也应承担的关怀责任。", "evidence": "P001-P002", "ambiguity": "没有说明义务来源和边界。"}], "examples_and_targets": ["无知而不自知者（P001）。"], "conditions": ["回答针对一般伦理态度，而非具体事件。"], "rhetoric_and_tone": "极简、断言式、宗教隐喻与黑色幽默。", "unresolved_questions": ["为何同情是义务而非资格，正文未展开论证。"]}, "provisional_tags": {"status": "provisional", "domain_candidates": [], "issue_candidates": [], "text_function_candidates": [], "object_candidates": [], "working_keywords": []}, "evidence_refs": [{"evidence_id": "E001", "paragraph_id": "P001", "field": "body", "paragraph_index": 1, "quote": "你没有资格。", "char_start": 0, "char_end": 6, "relation": "supports"}, {"evidence_id": "E002", "paragraph_id": "P002", "field": "body", "paragraph_index": 2, "quote": "但你有义务。", "char_start": 7, "char_end": 13, "relation": "supports"}], "notes": "极短篇，正文已读；论证主要依靠格言式断言。"}
{"record_type": "article_reading", "schema_version": "0.2.0", "corpus_sha256": "E8617186FB3A82FD117C790499191B0E7B14D7A0C06E084C6D91CB5C5BF6AAA4", "article_id": "eab37a83-4841-58ce-90d6-8ccb522172f3", "source_ordinal": 3432, "reading_ordinal": 620, "source_version": "v2-current", "metadata": {"title": "优秀与被爱", "published_at": "2021-03-21T17:13:35+08:00", "platform": "zhihu", "url": "https://www.zhihu.com/question/359757145/answer/1792051657"}, "structure": {"full_text_checked": true, "paragraphs": [{"paragraph_id": "P001", "field": "body", "index": 1, "text": "优不优秀都被爱。", "char_start": 0, "char_end": 8}, {"paragraph_id": "P002", "field": "body", "index": 2, "text": "问题是，爱是人格独立的，是不卑不亢的，是保持自由的，是有原则的。", "char_start": 9, "char_end": 41}, {"paragraph_id": "P003", "field": "body", "index": 3, "text": "是尊重也要求尊重的。", "char_start": 42, "char_end": 52}, {"paragraph_id": "P004", "field": "body", "index": 4, "text": "所以，对一些没醒过来的人而言，爱哪里够呢？", "char_start": 53, "char_end": 74}, {"paragraph_id": "P005", "field": "body", "index": 5, "text": "ta们要的是被贪。", "char_start": 75, "char_end": 84}, {"paragraph_id": "P006", "field": "body", "index": 6, "text": "人害怕只是被爱的话，对方没有什么依赖自己的地方，怕对方一个不高兴——或者更惨，发现了自己的真实样子——就会离开，所以，非得确认对方有在贪图自己什么，没有能力跟自己讨价还价，才敢安心的相信对方不会走。", "char_start": 85, "char_end": 184}, {"paragraph_id": "P007", "field": "body", "index": 7, "text": "优秀不是为了被爱，而是为了被贪。", "char_start": 185, "char_end": 201}, {"paragraph_id": "P008", "field": "body", "index": 8, "text": "人误以为被贪了就有话语权了而已。", "char_start": 202, "char_end": 218}], "images": [], "lexical": {"node_counts": {"paragraph": 8}, "divergence": false, "divergence_count": 0}}, "reading": {"status": "read", "reader_id": "deepseek-v4.1-flash", "started_at": "2026-09-20T00:00:00+08:00", "completed_at": "2026-09-20T00:00:00+08:00", "image_checked": false, "batch_id": "r001-b0104"}, "analysis": {"question_context": "提问者问优秀是否会带来被爱。作者先否定优秀是被爱条件，再区分被爱、被依赖和被贪图，讨论关系中的自由与控制。", "content_units": [{"unit_id": "U001", "paragraph_refs": ["P001", "P002", "P003"], "summary": "优秀与否都可能被爱；作者把爱定义为独立、自由、有原则且互相尊重。", "role": "definition"}, {"unit_id": "U002", "paragraph_refs": ["P004", "P005", "P006", "P007", "P008"], "summary": "部分人害怕只有被爱而没有被需要，因此要求确认对方贪图自己的某种资源，以换取安全感和话语权。", "role": "analysis"}], "main_claims": [{"claim_id": "C001", "claim_type": "author_explicit", "attribution": "author", "modality": "asserted", "statement": "优秀不是获得爱的必要条件，爱本身应保持人格独立、自由和互相尊重。", "evidence_refs": ["E001", "E002"]}, {"claim_id": "C002", "claim_type": "author_explicit", "attribution": "author", "modality": "asserted", "statement": "有些人把被贪图误认为获得关系话语权和稳定性的保证。", "evidence_refs": ["E003"]}], "argument_steps": ["否定优秀与被爱的必然关系（P001）。", "定义独立且有原则的爱（P002-P003）。", "解释从被爱转向被贪的依赖心理（P004-P008）。"], "concept_usage": [{"term": "被爱/被贪", "meaning": "被爱是对人格的尊重和关系承认，被贪是对方依赖或索取自己的资源。", "evidence": "P003-P008", "ambiguity": "作者未区分健康需要、互惠与剥削。"}], "examples_and_targets": ["担心对方发现真实样子而离开的关系不安全感（P004-P006）。"], "conditions": ["讨论的是亲密关系中的心理需求和控制感。"], "rhetoric_and_tone": "定义式、心理剖析式，使用反差和尖锐概念替换。", "unresolved_questions": ["爱、依赖、需要和贪图之间的界限未被进一步说明。"]}, "provisional_tags": {"status": "provisional", "domain_candidates": [], "issue_candidates": [], "text_function_candidates": [], "object_candidates": [], "working_keywords": []}, "evidence_refs": [{"evidence_id": "E001", "paragraph_id": "P001", "field": "body", "paragraph_index": 1, "quote": "优不优秀都被爱。", "char_start": 0, "char_end": 8, "relation": "supports"}, {"evidence_id": "E002", "paragraph_id": "P002", "field": "body", "paragraph_index": 2, "quote": "爱是人格独立的，是不卑不亢的", "char_start": 9, "char_end": 41, "relation": "supports"}, {"evidence_id": "E003", "paragraph_id": "P006", "field": "body", "paragraph_index": 6, "quote": "非得确认对方有在贪图自己什么", "char_start": 85, "char_end": 184, "relation": "supports"}], "notes": "正文已读；作者使用‘被贪’作为批判性关系概念，未作系统定义。"}
{"record_type": "article_reading", "schema_version": "0.2.0", "corpus_sha256": "E8617186FB3A82FD117C790499191B0E7B14D7A0C06E084C6D91CB5C5BF6AAA4", "article_id": "56e8024c-986c-569f-af50-5c2965477013", "source_ordinal": 3431, "reading_ordinal": 621, "source_version": "v2-current", "metadata": {"title": "帝国陷阱", "published_at": "2021-03-21T17:47:57+08:00", "platform": "zhihu", "url": "https://www.zhihu.com/question/450134525/answer/1792100923"}, "structure": {"full_text_checked": true, "paragraphs": [{"paragraph_id": "P001", "field": "body", "index": 1, "text": "当你发现自己正在一个坑里，第一件该做的事情就是停止往下挖。", "char_start": 0, "char_end": 29}, {"paragraph_id": "P002", "field": "body", "index": 2, "text": "美国最大的本钱就是军事上无敌的神话，这是美国国家信用的根基，而现在中国已经确信美国没可能在中国周边取得军事胜利，中国实际上正在采取一种攻击性策略。", "char_start": 30, "char_end": 103}, {"paragraph_id": "P003", "field": "body", "index": 3, "text": "那就是抓住每一个机会尝试用无可指责的方式将美国引向一种两难——要么展现软弱，要么被卷入没可能取胜的军事冲突，彻底丢掉“美军不可战胜”的神话，面对一次全球性的大崩溃，不但要从西太平洋、东亚、南亚、东南亚、西亚、东北非撤退，甚至将失去对相当部分对拉丁美洲的影响力。", "char_start": 104, "char_end": 234}, {"paragraph_id": "P004", "field": "body", "index": 4, "text": "只要给了中国以合理的回击立场——尤其是涉及到内政问题、南海、台湾、钓鱼岛等敏感问题，中国都会给予美国丝毫不假辞色的、明晃晃的、毫无台阶可下的迎头痛击。", "char_start": 235, "char_end": 310}, {"paragraph_id": "P005", "field": "body", "index": 5, "text": "这并不是“情绪激愤，难以自制”，而是有意而为之。", "char_start": 311, "char_end": 335}, {"paragraph_id": "P006", "field": "body", "index": 6, "text": "二哥站起来给了大哥一耳光，大哥唯一能挽回小弟信心的手段就是和二哥打一架。", "char_start": 336, "char_end": 372}, {"paragraph_id": "P007", "field": "body", "index": 7, "text": "大哥不敢动手，只敢吼叫，小弟们就会明白这意味着什么。", "char_start": 373, "char_end": 399}, {"paragraph_id": "P008", "field": "body", "index": 8, "text": "如果小弟们还有幻想，那么大哥一开口过线就再给一耳光。", "char_start": 400, "char_end": 426}, {"paragraph_id": "P009", "field": "body", "index": 9, "text": "一耳光，再一耳光，直到所有的小弟都清清楚楚，大哥不是宽宏大量，而的确是不敢。", "char_start": 427, "char_end": 465}, {"paragraph_id": "P010", "field": "body", "index": 10, "text": "美国这耳光挨多了，美元的信用堪忧。继续发行美元救命的打算更是危险。", "char_start": 466, "char_end": 499}, {"paragraph_id": "P011", "field": "body", "index": 11, "text": "如果美国看懂了这个策略，美国就别无选择，只能避免再给中国这样的机会把自己架在不得不证明自己的霸权有效性，而又根本无法冒险的境地。", "char_start": 500, "char_end": 564}, {"paragraph_id": "P012", "field": "body", "index": 12, "text": "而这会发出另一种信号——大哥不敢再惹事了。", "char_start": 565, "char_end": 586}, {"paragraph_id": "P013", "field": "body", "index": 13, "text": "虽然结果仍然是霸权落幕，但好歹方式较为体面。", "char_start": 587, "char_end": 609}, {"paragraph_id": "P014", "field": "body", "index": 14, "text": "可惜，美国就算明知中国的策略就是这么个阳谋，因为自己国内政治的逼迫，还是不得不硬着头皮往上撞。", "char_start": 610, "char_end": 657}, {"paragraph_id": "P015", "field": "body", "index": 15, "text": "这是想赌中国对实力对比仍然没有信心，想靠虚张声势蒙混过关。", "char_start": 658, "char_end": 687}, {"paragraph_id": "P016", "field": "body", "index": 16, "text": "阿拉斯加这次，就是蒙混过关被叫破了。", "char_start": 688, "char_end": 706}, {"paragraph_id": "P017", "field": "body", "index": 17, "text": "如果美国再来，只会被更不留情面的顶回去，不留情面到全世界都会觉得美国如果再不出兵，那就不用再装什么有实力了。", "char_start": 707, "char_end": 761}, {"paragraph_id": "P018", "field": "body", "index": 18, "text": "而它拿什么出？", "char_start": 762, "char_end": 769}], "images": [], "lexical": {"node_counts": {"paragraph": 18}, "divergence": false, "divergence_count": 0}}, "reading": {"status": "read", "reader_id": "deepseek-v4.1-flash", "started_at": "2026-09-20T00:00:00+08:00", "completed_at": "2026-09-20T00:00:00+08:00", "image_checked": false, "batch_id": "r001-b0104"}, "analysis": {"question_context": "提问者问中美首次会谈及结果和后续关注点。作者把会谈置于中美军事信誉、地区战略和霸权信号的框架中，提出高度确定性的地缘政治解释。", "content_units": [{"unit_id": "U001", "paragraph_refs": ["P001", "P002", "P003", "P004", "P005"], "summary": "作者认为中国已判断美国无法在周边取得军事胜利，并以不留情面的反击制造美国的两难。", "role": "thesis"}, {"unit_id": "U002", "paragraph_refs": ["P006", "P007", "P008", "P009", "P010", "P011", "P012"], "summary": "以大哥二哥比喻说明美国若不回应会显露软弱，若回应则可能陷入无法取胜的冲突。", "role": "analogy"}, {"unit_id": "U003", "paragraph_refs": ["P013", "P014", "P015", "P016", "P017", "P018"], "summary": "作者预判美国受国内政治驱动会继续试探，而中国会更强硬地回击。", "role": "prediction"}], "main_claims": [{"claim_id": "C001", "claim_type": "author_explicit", "attribution": "author", "modality": "asserted", "statement": "中国正在以有意而为的强硬反击，迫使美国在显露软弱和卷入无法取胜的冲突之间选择。", "evidence_refs": ["E001", "E002"]}, {"claim_id": "C002", "claim_type": "author_explicit", "attribution": "author", "modality": "predicted", "statement": "美国若继续试探，将进一步损耗军事不可战胜神话和美元信用。", "evidence_refs": ["E003"]}], "argument_steps": ["提出停止继续挖坑的总喻（P001）。", "说明美国军事神话和中国反击策略（P002-P005）。", "用大哥二哥关系类比信誉博弈（P006-P012）。", "推演美国国内政治和未来对撞（P013-P018）。"], "concept_usage": [{"term": "美国军事上无敌的神话", "meaning": "支撑美国国家信用与盟友信心的霸权不可战胜叙事。", "evidence": "P002-P003", "ambiguity": "没有给出可检验指标。"}, {"term": "阳谋", "meaning": "明知对方策略仍因自身约束不得不进入对方设置的两难。", "evidence": "P014-P017", "ambiguity": "属于作者的战略解释。"}], "examples_and_targets": ["阿拉斯加会谈（P017）。", "南海、台湾、钓鱼岛等敏感议题（P004）。"], "conditions": ["分析建立在美国不会或不能在中国周边发动可胜战争的前提上。", "关于未来美国行动属于作者预测。"], "rhetoric_and_tone": "战略论辩、强烈断言和大哥二哥类比，语气自信且带有预言式收束。", "unresolved_questions": ["会谈具体议题、事实结果和军事能力判断需要外部资料核验。", "美元信用与地区撤退的因果链未展开证据。"]}, "provisional_tags": {"status": "provisional", "domain_candidates": [], "issue_candidates": [], "text_function_candidates": [], "object_candidates": [], "working_keywords": []}, "evidence_refs": [{"evidence_id": "E001", "paragraph_id": "P002", "field": "body", "paragraph_index": 2, "quote": "美国最大的本钱就是军事上无敌的神话", "char_start": 30, "char_end": 103, "relation": "supports"}, {"evidence_id": "E002", "paragraph_id": "P005", "field": "body", "paragraph_index": 5, "quote": "这并不是“情绪激愤，难以自制”，而是有意而为之", "char_start": 311, "char_end": 335, "relation": "supports"}, {"evidence_id": "E003", "paragraph_id": "P010", "field": "body", "paragraph_index": 10, "quote": "美元的信用堪忧", "char_start": 466, "char_end": 499, "relation": "supports"}], "notes": "正文已读；这是强预测性的地缘政治解释，事实和预测均需外部核查。"}
{"record_type": "article_reading", "schema_version": "0.2.0", "corpus_sha256": "E8617186FB3A82FD117C790499191B0E7B14D7A0C06E084C6D91CB5C5BF6AAA4", "article_id": "9a59d12b-84cd-54df-877a-f07339708884", "source_ordinal": 3430, "reading_ordinal": 622, "source_version": "v2-current", "metadata": {"title": "适合思辨的语言", "published_at": "2021-03-22T04:08:09+08:00", "platform": "zhihu", "url": "https://www.zhihu.com/question/23781421/answer/1792779456"}, "structure": {"full_text_checked": true, "paragraphs": [{"paragraph_id": "P001", "field": "body", "index": 1, "text": "是否适合思辨和语言本身是没关系的，主要看该语种语境中既有的“思辨资产”有多少。", "char_start": 0, "char_end": 39}, {"paragraph_id": "P002", "field": "body", "index": 2, "text": "也就是既被清晰定义（或至少有所界定）而又广为大众所知（或至少广为学界所知）的常用概念有多少。", "char_start": 40, "char_end": 86}, {"paragraph_id": "P003", "field": "body", "index": 3, "text": "思辨的效率靠的是这些资产的高效运用，而不是语言本身如何。只要一个国家的学术界和学术报道业在这个问题上做了足够多有效的投资，就能做到这一点。即使是斯瓦希里语、泰米尔语，只要做了这样的投入，也一样会变得利于思辨。", "char_start": 87, "char_end": 191}, {"paragraph_id": "P004", "field": "body", "index": 4, "text": "只不过并非每个语种背后的国家和民族都有这个历史机遇、有这个本钱去完成这个事业罢了。", "char_start": 192, "char_end": 233}, {"paragraph_id": "P005", "field": "body", "index": 5, "text": "但显然，这对中国不成其为问题。", "char_start": 234, "char_end": 249}, {"paragraph_id": "P006", "field": "body", "index": 6, "text": "实际上，在以百年计的长期竞争之中，中文恐怕还有优势。", "char_start": 250, "char_end": 276}], "images": [], "lexical": {"node_counts": {"paragraph": 6}, "divergence": false, "divergence_count": 0}}, "reading": {"status": "read", "reader_id": "deepseek-v4.1-flash", "started_at": "2026-09-20T00:00:00+08:00", "completed_at": "2026-09-20T00:00:00+08:00", "image_checked": false, "batch_id": "r001-b0104"}, "analysis": {"question_context": "提问者问黑格尔为何认为汉语不宜思辨。作者拒绝把问题归因于语言本体，改以一个语种的概念资产、定义质量和学术投入解释思辨能力。", "content_units": [{"unit_id": "U001", "paragraph_refs": ["P001", "P002", "P003"], "summary": "思辨适宜性与语言本身无关，关键是语境中清晰定义且被广泛掌握的概念资产数量。", "role": "thesis"}, {"unit_id": "U002", "paragraph_refs": ["P004", "P005", "P006"], "summary": "只要学术界和学术传播投入足够，任何语言都可形成有利于思辨的概念工具；中国具备长期投入条件。", "role": "argument"}], "main_claims": [{"claim_id": "C001", "claim_type": "author_explicit", "attribution": "author", "modality": "asserted", "statement": "语言是否适合思辨主要取决于既有概念资产的清晰度和普及度，而非语言本身。", "evidence_refs": ["E001", "E002"]}, {"claim_id": "C002", "claim_type": "author_explicit", "attribution": "author", "modality": "predicted", "statement": "通过长期学术投资，中文不仅可以适合思辨，甚至可能在长期竞争中具备优势。", "evidence_refs": ["E003"]}], "argument_steps": ["否定语言本体决定论（P001）。", "定义思辨资产及其效率作用（P002-P003）。", "用跨语言假设和中国前景完成论证（P004-P006）。"], "concept_usage": [{"term": "思辨资产", "meaning": "被清晰定义或界定、并被学界或大众掌握的常用概念集合。", "evidence": "P002-P003", "ambiguity": "没有给出资产数量或效率的测量标准。"}], "examples_and_targets": ["斯瓦希里语、泰米尔语作为跨语言假设例子（P004）。"], "conditions": ["需要国家学术界和学术报道业持续有效投资。"], "rhetoric_and_tone": "简洁的概念澄清和条件推理，结尾转为对中文长期优势的预测。", "unresolved_questions": ["黑格尔原话及其论证未在正文中引用，需外部核查。", "中文‘优势’的具体指标未说明。"]}, "provisional_tags": {"status": "provisional", "domain_candidates": [], "issue_candidates": [], "text_function_candidates": [], "object_candidates": [], "working_keywords": []}, "evidence_refs": [{"evidence_id": "E001", "paragraph_id": "P001", "field": "body", "paragraph_index": 1, "quote": "是否适合思辨和语言本身是没关系的", "char_start": 0, "char_end": 39, "relation": "supports"}, {"evidence_id": "E002", "paragraph_id": "P001", "field": "body", "paragraph_index": 1, "quote": "既有的“思辨资产”有多少", "char_start": 0, "char_end": 39, "relation": "supports"}, {"evidence_id": "E003", "paragraph_id": "P006", "field": "body", "paragraph_index": 6, "quote": "中文恐怕还有优势", "char_start": 250, "char_end": 276, "relation": "supports"}], "notes": "正文已读；本文未直接重建黑格尔原论证，只提供作者自己的反解释。"}
